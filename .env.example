BOOTSTRAP_ADMIN_PASSWORD=

# AI assistant (OpenAI-compatible chat completions API)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
