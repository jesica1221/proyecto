EXPO_PUBLIC_API_URL=http://localhost:4000/eficient-parking-lot
PORT=4000
NODE_ENV=development
SQLITE_PATH=backend/data/parking.sqlite
JWT_SECRET=
DEMO_DATA=true

# Optional: secure registration of staff accounts
ADMIN_REGISTRATION_KEY=
